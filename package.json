{
  "name": "pocket-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "cn": "cn build --content 'src/**/*.{ts,tsx}' --content 'content/**/*.ts' -o src/lib/cn-tables.ts --css src/app/globals.css -q",
    "prebuild": "npm run cn && node scripts/make-blur-previews.mjs && node scripts/build-sw.mjs && tsx scripts/youtube-snapshot.mts --if-vercel",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p sw",
    "format": "prettier --write .",
    "test": "playwright test",
    "content:check": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "maath": "^0.10.8",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "mailparser": "^3.12.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
