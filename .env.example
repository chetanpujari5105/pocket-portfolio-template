# Copy to .env.local (never commit real values). All optional — the site degrades gracefully.

# Contact form (Resend) — server only. Without a key the form shows "email me directly".
RESEND_API_KEY=
# Where contact messages go (defaults to `email` in content/profile.ts)
CONTACT_TO_EMAIL=
# Verified Resend sender, e.g. "Your Name <hello@yourdomain.com>" (defaults to onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# Optional "Ask" app. The key is server only; the flag shows the app.
NEXT_PUBLIC_ENABLE_ASK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional GitHub heatmap via GraphQL (server only; a fine-grained token with no permissions).
# Without it the widget parses the public contributions page.
GITHUB_TOKEN=

# Canonical URL for SEO/OG (defaults to Vercel's production URL, then site.url in content/profile.ts)
NEXT_PUBLIC_SITE_URL=
