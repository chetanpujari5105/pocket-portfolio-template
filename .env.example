# Copy to .env.local (never commit real values). All optional: the site degrades gracefully.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Contact form email, server only. Steps: README → "Contact form email".
# Gmail SMTP: your Gmail address and a Google app password (16 letters; spaces are fine).
# Without these (and without RESEND_API_KEY) the form can't send and offers "email me directly".
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where messages go. Unset = `email` in content/profile.ts. Replies go to the visitor (Reply-To).
CONTACT_TO_EMAIL=
# Optional fallback, used only when RESEND_API_KEY is set and neither Gmail variable is.
RESEND_API_KEY=
# Resend sender on a verified domain, e.g. "Your Name <hello@yourdomain.com>". Unset = the test
# sender onboarding@resend.dev, which ONLY delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=

# Optional GitHub heatmap via GraphQL (server only; a fine-grained token with no permissions).
# Without it the widget reads the public contributions page, then the committed snapshot.
GITHUB_TOKEN=

# Optional "Ask" app. The key is server only; the flag shows the app.
NEXT_PUBLIC_ENABLE_ASK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# App tile faces: unset/`original` = the template's own gradient-and-glyph set (ships with it).
# `ios18` = an icon pack you add yourself to public/icons/ios18 (README → "Optional: an icon pack").
NEXT_PUBLIC_ICON_PACK=

# Canonical URL for SEO/OG (defaults to Vercel's production URL, then site.url in content/profile.ts)
NEXT_PUBLIC_SITE_URL=
